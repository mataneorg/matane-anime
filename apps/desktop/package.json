{
  "name": "@matane-anime/desktop",
  "productName": "Matane Anime",
  "desktopName": "matane-anime.desktop",
  "version": "0.1.0-beta.4",
  "private": true,
  "description": "Open-source desktop anime player",
  "author": "SukunDev",
  "homepage": "https://github.com/mataneorg/matane-anime",
  "license": "GPL-3.0-only",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack:dir": "electron-vite build && electron-builder --dir --publish never",
    "dist": "electron-vite build && electron-builder --linux AppImage --publish never",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "postinstall": "electron-rebuild -f -o better-sqlite3",
    "db:generate": "drizzle-kit generate",
    "fixtures": "bash scripts/make-fixtures.sh",
    "fixtures:download": "bash scripts/make-download-fixtures.sh",
    "spike:report": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/spike-report.mts",
    "e2e": "electron --version > /dev/null && electron-vite build && playwright test"
  },
  "devDependencies": {
    "@catppuccin/tailwindcss": "1.0.0",
    "@electron/rebuild": "4.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@matane-anime/test-site": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/router-plugin": "1.168.42",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "0.31.11",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "hls.js": "1.7.3",
    "i18next": "26.4.2",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "zustand": "5.0.15"
  },
  "dependencies": {
    "@matane-anime/extension-repo": "workspace:*",
    "@matane-anime/extension-runtime": "workspace:*",
    "@matane-anime/extension-sdk": "workspace:*",
    "@matane-anime/shared": "workspace:*",
    "@tanstack/react-virtual": "3.14.13",
    "better-sqlite3": "13.0.3",
    "cheerio": "1.2.0",
    "drizzle-orm": "0.45.3",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "quickjs-emscripten": "0.32.0",
    "zod": "4.6.5"
  }
}
